TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_SECRET=
WEBHOOK_LOG_FILE=logs/webhook.log
ALERT_COOLDOWN_SECONDS=300
SCAN_INTERVAL_SECONDS=60
BINANCE_SYMBOL=BTCUSDT

X_NEWS_FEED_FILE=/opt/smct-alert/config/x_news_feed.json
X_NEWS_TTL_MINUTES=180

TELEGRAM_OPS_POLL_ENABLED=1
TELEGRAM_ERROR_ALERT_COOLDOWN_SECONDS=900

# Unclosed abnormal-volume weak TG (default off; shadow does not need this)
SMCT_ABNORMAL_VOLUME_WEAK_ENABLED=0

# Plan B: off (default), shadow (log only), live (reviewed opt-in).
SMCT_EARLY_OBSERVATION_MODE=off
SMCT_EARLY_OBSERVATION_STATE_FILE=/opt/smct-alert/state/early_observation.sqlite3

[Unit]
Description=AMST BTCUSDT 15m shadow (log-only)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/amst-alert
ExecStart=/opt/amst-alert/venv/bin/python /opt/amst-alert/scripts/run_15m_shadow.py --shadow --log /opt/amst-alert/logs/15m_shadow.log
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

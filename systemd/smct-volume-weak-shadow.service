[Unit]
Description=SMCT BTCUSDT unclosed volume weak shadow (log-only)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/smct-alert
ExecStart=/opt/smct-alert/venv/bin/python /opt/smct-alert/scripts/run_volume_weak_shadow.py --shadow --log /opt/smct-alert/logs/volume_weak_shadow.log
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
